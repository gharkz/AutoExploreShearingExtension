<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Title>Auto-Explore Shearing Extension</Title>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Reference Include="Elin_AutoExplore"><HintPath>$(AutoExploreDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ElinDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(ElinDir)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity"><HintPath>$(ElinDir)\BepInEx\core\BepInEx.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Elin"><HintPath>$(ElinDir)\Elin_Data\Managed\Elin.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Plugins.BaseCore"><HintPath>$(ElinDir)\Elin_Data\Managed\Plugins.BaseCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ElinDir)\Elin_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ElinDir)\Elin_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
